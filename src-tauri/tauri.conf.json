{
  "productName": "PonyClean",
  "version": "0.3.4",
  "identifier": "com.pony.ponyclean",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5183",
    "frontendDist": "../frontend/dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/StoreLogo.png"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1QTFEQkY3RjczRjM0M0MKUldROE5ELzM5OXVobFhEb21JZFFHR0hLaWhKSlBxb1psV2duc2trR0lvKzZBdng5bTErNy82NCsK",
      "endpoints": [
        "https://github.com/lanhui100/pony_clean/releases/latest/download/latest.json",
        "https://cnb.cool/lanhui100/pony_clean/-/git/raw/main/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive",
        "installerArgs": ["/R"]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "capsule",
        "title": "",
        "width": 166,
        "height": 44,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "visible": false
      },
      {
        "label": "island",
        "title": "",
        "width": 315,
        "height": 100,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws:; img-src 'self' data:; font-src 'self' data:"
    }
  }
}
